<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="none">
    <defs>
      <radialGradient id="wmGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ec4899" stop-opacity="0.4"/>
        <stop offset="100%" stop-color="#0b0e17" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <rect width="200" height="200" rx="28" fill="#070a12"/>
    <rect x="3" y="3" width="194" height="194" rx="25" stroke="#ec4899" stroke-width="1.5" stroke-opacity="0.4"/>
    <circle cx="100" cy="95" r="75" fill="url(#wmGlow)"/>
    <!-- Walkman Body -->
    <rect x="52" y="45" width="96" height="95" rx="12" fill="#1e1b4b" stroke="#ec4899" stroke-width="2"/>
    <!-- Cassette Window -->
    <rect x="64" y="60" width="72" height="46" rx="6" fill="#0f172a" stroke="#00f0ff" stroke-width="1.5"/>
    <!-- Tape Reels -->
    <circle cx="82" cy="83" r="12" fill="#334155" stroke="#f43f5e" stroke-width="2"/>
    <circle cx="118" cy="83" r="12" fill="#334155" stroke="#f43f5e" stroke-width="2"/>
    <circle cx="82" cy="83" r="4" fill="#00f0ff"/>
    <circle cx="118" cy="83" r="4" fill="#00f0ff"/>
    <!-- Buttons & Knobs -->
    <rect x="64" y="116" width="14" height="8" rx="2" fill="#00f0ff"/>
    <rect x="82" y="116" width="14" height="8" rx="2" fill="#f43f5e"/>
    <rect x="100" y="116" width="14" height="8" rx="2" fill="#a855f7"/>
    <!-- Headphone Jack with Sound Wave -->
    <circle cx="132" cy="120" r="4" fill="#facc15"/>
    <!-- Label Banner -->
    <rect x="25" y="156" width="150" height="24" rx="6" fill="#831843" stroke="#ec4899" stroke-width="1.2"/>
    <text x="100" y="172" font-size="11" font-family="monospace" font-weight="900" fill="#f472b6" text-anchor="middle" letter-spacing="1">#07 賽博 Walkman</text>
  </svg>