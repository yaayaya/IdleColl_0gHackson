<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="none">
    <defs>
      <radialGradient id="cpGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#00f0ff" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="#0b0e17" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fef08a"/>
        <stop offset="50%" stop-color="#eab308"/>
        <stop offset="100%" stop-color="#ca8a04"/>
      </linearGradient>
    </defs>
    <rect width="200" height="200" rx="28" fill="#070a12"/>
    <rect x="3" y="3" width="194" height="194" rx="25" stroke="#f59e0b" stroke-width="2" stroke-opacity="0.8"/>
    <circle cx="100" cy="95" r="80" fill="url(#cpGlow)"/>
    <!-- Chip Outer Pins -->
    <g stroke="url(#goldGrad)" stroke-width="2" stroke-linecap="round">
      <line x1="58" y1="65" x2="44" y2="65"/><line x1="58" y1="80" x2="44" y2="80"/><line x1="58" y1="95" x2="44" y2="95"/><line x1="58" y1="110" x2="44" y2="110"/><line x1="58" y1="125" x2="44" y2="125"/>
      <line x1="142" y1="65" x2="156" y2="65"/><line x1="142" y1="80" x2="156" y2="80"/><line x1="142" y1="95" x2="156" y2="95"/><line x1="142" y1="110" x2="156" y2="110"/><line x1="142" y1="125" x2="156" y2="125"/>
    </g>
    <!-- Chip Silicon Die Body -->
    <rect x="58" y="52" width="84" height="84" rx="12" fill="#0f172a" stroke="url(#goldGrad)" stroke-width="2.5" filter="drop-shadow(0 0 16px rgba(234,179,8,0.4))"/>
    <!-- Inner Core Nexus -->
    <rect x="74" y="68" width="52" height="52" rx="8" fill="#0369a1" stroke="#00f0ff" stroke-width="1.8"/>
    <!-- 0G Logo Glowing Emblem -->
    <text x="100" y="100" font-size="20" font-family="monospace" font-weight="900" fill="#00f0ff" text-anchor="middle" filter="drop-shadow(0 0 8px #00f0ff)">0G</text>
    <!-- Quantum Circuit Traces -->
    <circle cx="100" cy="95" r="22" stroke="#fef08a" stroke-width="1" stroke-dasharray="4 3"/>
    <!-- Label Banner -->
    <rect x="25" y="156" width="150" height="24" rx="6" fill="#78350f" stroke="#f59e0b" stroke-width="1.5"/>
    <text x="100" y="172" font-size="11" font-family="monospace" font-weight="900" fill="#fef08a" text-anchor="middle" letter-spacing="1">#12 0G 原始晶片</text>
  </svg>